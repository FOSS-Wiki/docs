[Unit]
Description=Wiki archiving script
Documentation=https://github.com/FOSS-Wiki/docs/tree/main/wiki-archive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=wikiarchive
Group=wikiarchive
WorkingDirectory=/var/lib/wikiarchive
RuntimeDirectory=wikiarchive
Environment=XDG_RUNTIME_DIR=/run/wikiarchive
Environment=PATH=/var/lib/wikiarchive/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/wiki-archive.sh
TimeoutStartSec=infinity

UMask=0077
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/wikiarchive /opt/mirror
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
